# Copy this file to .env and fill in real values for your machine/server.
# manage.py does NOT auto-load .env — see README for how to load it
# (python-decouple / django-environ) if you want that convenience.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave EMAIL_HOST_USER/EMAIL_HOST_PASSWORD blank to just print emails to
# the console instead of sending them for real (fine for local testing).
# For real sending with Gmail: turn on 2-Step Verification on that Google
# account, then create an "App Password" at
# https://myaccount.google.com/apppasswords and use it as
# EMAIL_HOST_PASSWORD below (NOT your normal Gmail password).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Leave these blank to keep SMS as log-only (no real text sent). Fill them
# in with your Twilio account details to send real SMS from Send Allotment.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
